<!-- A 7-joint capsule arm with a two-finger slide gripper and a free box on the floor (a generic grasping test
     scene): position servos (gear 1), joint limits, explicit contact pairs of the kinds plane-box, plane-capsule,
     box-box and capsule-box, pyramidal cone, implicitfast. Used by scripts/collision/midphase_check.py (arm, clutter),
     scripts/engines_check.py and scripts/motor_forest_check.py. Keyframe "home": the hand above the box, the fingers open. -->
<mujoco model="arm_box">
  <compiler angle="radian"/>
  <option timestep="0.005" integrator="implicitfast" cone="pyramidal" iterations="5"/>
  <default>
    <geom contype="0" conaffinity="0" friction="1 0.005 0.0001"/>
    <joint damping="1" armature="0.05" limited="true" range="-2.8 2.8"/>
    <position kp="1000" kv="50"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1"/>
    <geom name="base" type="cylinder" size="0.07 0.075" pos="0 0 0.075" mass="2"/>
    <body name="link1" pos="0 0 0.15">
      <joint name="j1" axis="0 0 1"/>
      <geom name="link1" type="capsule" fromto="0 0 0 0 0 0.18" size="0.05" mass="2"/>
      <body name="link2" pos="0 0 0.18">
        <joint name="j2" axis="0 1 0" range="-1.7 1.7"/>
        <geom name="link2" type="capsule" fromto="0 0 0 0 0 0.3" size="0.045" mass="2"/>
        <body name="link3" pos="0 0 0.3">
          <joint name="j3" axis="0 0 1"/>
          <geom name="link3" type="capsule" fromto="0 0 0 0 0 0.1" size="0.04" mass="1"/>
          <body name="link4" pos="0 0 0.1">
            <joint name="j4" axis="0 1 0"/>
            <geom name="link4" type="capsule" fromto="0 0 0 0 0 0.3" size="0.04" mass="1.5"/>
            <body name="link5" pos="0 0 0.3">
              <joint name="j5" axis="0 0 1"/>
              <geom name="link5" type="capsule" fromto="0 0 0 0 0 0.08" size="0.035" mass="0.7"/>
              <body name="link6" pos="0 0 0.08">
                <joint name="j6" axis="0 1 0"/>
                <geom name="link6" type="capsule" fromto="0 0 0 0 0 0.08" size="0.035" mass="0.7"/>
                <body name="hand" pos="0 0 0.08">
                  <joint name="j7" axis="0 0 1"/>
                  <geom name="hand_capsule" type="capsule" fromto="0 -0.07 0.02 0 0.07 0.02" size="0.025" mass="0.5"/>
                  <site name="grip" pos="0 0 0.1"/>
                  <body name="left_finger" pos="0 0 0.05">
                    <joint name="left_finger" type="slide" axis="0 1 0" range="0 0.04" damping="5"/>
                    <geom name="left_finger_pad" type="box" pos="0 0.01 0.04" size="0.01 0.005 0.025" mass="0.05"/>
                  </body>
                  <body name="right_finger" pos="0 0 0.05">
                    <joint name="right_finger" type="slide" axis="0 -1 0" range="0 0.04" damping="5"/>
                    <geom name="right_finger_pad" type="box" pos="0 -0.01 0.04" size="0.01 0.005 0.025" mass="0.05"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
    <body name="box" pos="0.5 0 0.03">
      <freejoint name="box"/>
      <geom name="box" type="box" size="0.02 0.02 0.03" mass="0.1"/>
    </body>
  </worldbody>
  <contact>
    <pair name="floor__hand_capsule" geom1="floor" geom2="hand_capsule"/>
    <pair name="floor__left_finger_pad" geom1="floor" geom2="left_finger_pad"/>
    <pair name="floor__right_finger_pad" geom1="floor" geom2="right_finger_pad"/>
    <pair name="floor__box" geom1="floor" geom2="box"/>
    <pair name="left_finger_pad__box" geom1="left_finger_pad" geom2="box"/>
    <pair name="right_finger_pad__box" geom1="right_finger_pad" geom2="box"/>
    <pair name="hand_capsule__box" geom1="hand_capsule" geom2="box"/>
    <pair name="link6__box" geom1="link6" geom2="box"/>
  </contact>
  <actuator>
    <position name="a1" joint="j1" ctrlrange="-2.8 2.8"/>
    <position name="a2" joint="j2" ctrlrange="-1.7 1.7"/>
    <position name="a3" joint="j3" ctrlrange="-2.8 2.8"/>
    <position name="a4" joint="j4" ctrlrange="-2.8 2.8"/>
    <position name="a5" joint="j5" ctrlrange="-2.8 2.8"/>
    <position name="a6" joint="j6" ctrlrange="-2.8 2.8"/>
    <position name="a7" joint="j7" ctrlrange="-2.8 2.8"/>
    <position name="left_finger" joint="left_finger" kp="100" kv="5" ctrlrange="0 0.04"/>
    <position name="right_finger" joint="right_finger" kp="100" kv="5" ctrlrange="0 0.04"/>
  </actuator>
  <keyframe>
    <key name="home" qpos="0 0.9616 0 1.71 0 0.4696 0 0.04 0.04 0.5 0 0.03 1 0 0 0" ctrl="0 0.9616 0 1.71 0 0.4696 0 0.04 0.04"/>
  </keyframe>
</mujoco>

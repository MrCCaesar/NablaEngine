<!-- Cylinder primitives (forest engine): a tilted cylinder dropped on the floor (plane-cylinder, up to 4 contacts), a
     sphere resting on a static lying cylinder (sphere-cylinder: side), a sphere on an upright static cylinder's cap. -->
<mujoco model="cyl_prim">
  <option timestep="0.002" integrator="implicitfast"/>
  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1"/>
    <geom name="log" type="cylinder" size="0.05 0.3" pos="0.6 0 0.05" euler="90 0 0"/>
    <geom name="post" type="cylinder" size="0.06 0.1" pos="-0.6 0 0.1"/>
    <body name="can" pos="0 0 0.09" euler="20 10 0">
      <freejoint/>
      <geom name="can" type="cylinder" size="0.05 0.08" density="500"/>
    </body>
    <body name="ball1" pos="0.62 0.05 0.141">
      <freejoint/>
      <geom name="ball1" type="sphere" size="0.04" density="500"/>
    </body>
    <body name="ball2" pos="-0.58 0.01 0.241">
      <freejoint/>
      <geom name="ball2" type="sphere" size="0.04" density="500"/>
    </body>
  </worldbody>
</mujoco>

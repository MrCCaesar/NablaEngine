<!-- T1: a slide-finger gripper pair coupled by a tendon equality (the tendon "diff" = right - left held at 0), one
     finger servo, closing on a free box on the floor. The fingers are separate trees under the world: the equality
     couples them in the Newton Hessian; the "split" tendon (0.5 left + 0.5 right) has armature (on M's diagonal only:
     MuJoCo adds it on M's sparsity pattern, and the fingers are separate trees) and a limit (the opening, range 0.005 .. 0.04) is a tendon limit row -->
<mujoco model="eq_t1_fingers">
  <option timestep="0.002" integrator="implicitfast"/>
  <default>
    <geom friction="1 0.005 0.0001" solref="0.01 1"/>
    <joint damping="2" armature="0.01"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="1 1 0.1"/>
    <body name="left" pos="0 0.06 0.03">
      <joint name="left" type="slide" axis="0 -1 0" range="-0.01 0.05" limited="true"/>
      <geom name="left_pad" type="box" size="0.02 0.005 0.02" mass="0.1"/>
    </body>
    <body name="right" pos="0 -0.06 0.03">
      <joint name="right" type="slide" axis="0 1 0" range="-0.01 0.05" limited="true"/>
      <geom name="right_pad" type="box" size="0.02 0.005 0.02" mass="0.1"/>
    </body>
    <body name="box" pos="0 0 0.02">
      <freejoint name="box"/>
      <geom name="box" type="box" size="0.015 0.025 0.02" mass="0.05"/>
    </body>
  </worldbody>
  <contact>
    <exclude body1="left" body2="right"/>
    <exclude body1="world" body2="left"/>
    <exclude body1="world" body2="right"/>
  </contact>
  <tendon>
    <fixed name="diff">
      <joint joint="right" coef="1"/>
      <joint joint="left" coef="-1"/>
    </fixed>
    <fixed name="split" limited="true" range="0.005 0.04" armature="0.02" solreflimit="0.01 1"
           solimplimit="0.9 0.95 0.001">
      <joint joint="left" coef="0.5"/>
      <joint joint="right" coef="0.5"/>
    </fixed>
  </tendon>
  <equality>
    <tendon name="mimic" tendon1="diff" solref="0.005 1" solimp="0.95 0.99 0.001"/>
  </equality>
  <actuator>
    <position name="grip" joint="left" kp="200" kv="5" ctrlrange="-0.01 0.05" forcerange="-20 20"/>
  </actuator>
</mujoco>

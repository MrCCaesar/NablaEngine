<!-- Joint limits with their own solref / solimp per joint (forest engine: step.limit_hooks): a fixed-base arm with
     narrow hinge and slide ranges, five parameter sets (two solimp powers and midpoints, so the general power path),
     motors that drive the joints into their limits, a capsule tip that touches the floor and a free box. -->
<mujoco model="l1_limit_sets">
  <option timestep="0.002" integrator="implicitfast"/>
  <default>
    <joint damping="0.5" armature="0.01" limited="true"/>
    <geom density="800"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1"/>
    <body name="base" pos="0 0 0.45">
      <joint name="j1" axis="0 0 1" range="-0.4 0.4"/>
      <geom name="base" type="capsule" fromto="0 0 0 0.15 0 0" size="0.03"/>
      <body name="upper" pos="0.15 0 0">
        <joint name="j2" axis="0 1 0" range="-0.3 0.5" solreflimit="0.005 1" solimplimit="0.95 0.99 0.001 0.5 2"/>
        <geom name="upper" type="capsule" fromto="0 0 0 0.15 0 -0.1" size="0.025"/>
        <body name="fore" pos="0.15 0 -0.1">
          <joint name="j3" axis="0 1 0" range="-0.2 0.6" solreflimit="0.01 0.7" solimplimit="0.8 0.99 0.01 0.3 3"/>
          <geom name="fore" type="capsule" fromto="0 0 0 0.1 0 -0.1" size="0.02"/>
          <body name="slider" pos="0.1 0 -0.1">
            <joint name="s4" type="slide" axis="0 0 -1" range="0 0.08" solreflimit="0.03 1.2"
                   solimplimit="0.9 0.95 0.002 0.6 1"/>
            <geom name="slider" type="capsule" fromto="0 0 0 0 0 -0.08" size="0.018"/>
            <body name="tip" pos="0 0 -0.08">
              <joint name="j5" axis="1 0 0" range="-0.25 0.25"/>
              <geom name="tip" type="capsule" fromto="0 0 0 0.06 0 0" size="0.015"/>
            </body>
          </body>
        </body>
      </body>
    </body>
    <body name="box" pos="0.32 0.05 0.03">
      <freejoint/>
      <geom name="box" type="box" size="0.03 0.03 0.03" density="300"/>
    </body>
  </worldbody>
  <actuator>
    <motor joint="j1" ctrlrange="-3 3"/>
    <motor joint="j2" ctrlrange="-6 6"/>
    <motor joint="j3" ctrlrange="-4 4"/>
    <motor joint="s4" ctrlrange="-20 20"/>
    <motor joint="j5" ctrlrange="-1 1"/>
  </actuator>
</mujoco>
